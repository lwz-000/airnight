# pnpm 配置：把 store / 全局目录都放在项目内，避免读写用户目录
store-dir=.pnpm-store
global-dir=.pnpm-global
global-bin-dir=.pnpm-bin
state-dir=.pnpm-state
cache-dir=.pnpm-cache
# 关闭「自动安装 peer dependencies」的提示噪音
auto-install-peers=true
strict-peer-dependencies=false

# 注：依赖布局（node-linker=hoisted）写在 pnpm-workspace.yaml 里 ——
# pnpm 10+ 会忽略 .npmrc 里的这个键，写在这儿不生效（踩过一次）。
